# Demo mode only. Copy to .env when overriding host ports.
API_PORT=8000
WEB_PORT=8080

# Optional real-adapter settings are operator supplied; Compose demo does not consume them.
PADDLE_MODEL_ROOT=/models/paddleocr
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL_TAG=your-installed-model-tag
